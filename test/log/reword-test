#!/bin/sh

. libtest.sh
. libgit.sh

test_require git-history

export GIT_EDITOR="printf 'Second, reworded\n' >"

# Keep the rewritten commit IDs stable.
export GIT_COMMITTER_DATE="1234567890 +0000"

steps '
	:11
	:edit
	:save-display reword.screen
'

git_init

test_setup_work_dir()
{
	git_commit --author="$IDENT_A" --message="First"
	git_commit --author="$IDENT_A" --message="Second"
	git_commit --author="$IDENT_A" --message="Third"
}

test_tig log --graph

