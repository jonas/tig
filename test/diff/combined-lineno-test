#!/bin/sh

. libtest.sh
. libgit.sh

git_init

in_work_dir git_add f.txt "$(printf 'a\nb\nc\nd\ne')"
in_work_dir git_commit -m "Initial commit"
in_work_dir git checkout -q -b side
in_work_dir git_add f.txt "$(printf 'a\nB2\nc\nd\nS2\ne')"
in_work_dir git_commit -m "Change the side branch"
in_work_dir git checkout -q -
in_work_dir git_add f.txt "$(printf 'a\nM1\nb\nc\nd\ne')"
in_work_dir git_commit -m "Change the main branch"
in_work_dir git merge -q --no-commit side > /dev/null || :
in_work_dir git_add f.txt "$(printf 'a\nM1\nb\nc\nS2\ne')"
in_work_dir git_commit -m "Merge the side branch"

steps '
	:/[-][-]d
	:exec !sh -c "echo d %(lineno_old) >> $HOME/lineno.log"
	:view-blame
	:save-display blame-old.screen
	:view-close
	:/[+] S2
	:exec !sh -c "echo S2 %(lineno) >> $HOME/lineno.log"
	:view-blame
	:save-display blame-new.screen
	:view-close
	:save-display diff.screen
'

test_tig show HEAD

assert_equals 'lineno.log' <<EOF
d 5
S2 5
EOF

assert_equals 'diff.screen' <<EOF
