#!/bin/sh

. libtest.sh
. libgit.sh

export COLUMNS=40

in_work_dir create_repo_from_tgz "$base_dir/files/scala-js-benchmarks.tgz"

# Mimic diff-highlight by marking the changed parts in reverse video.
file bin/diff-highlight <<\EOF
#!/bin/sh
esc=$(printf '\033')
exec sed -e "/^-/s/js\.Dynamic\.global/${esc}[7m&${esc}[27m/" \
	 -e "/^+/s/\[js\.Any\]/${esc}[7m&${esc}[27m/"
EOF

chmod +x bin/diff-highlight

tigrc <<EOF
set diff-highlight = true
set wrap-lines = true
EOF

steps '
	:40
	:save-display wrapped.screen
	:save-view wrapped.view
'

PATH="./bin:$PATH" test_tig show master^

assert_equals 'wrapped.screen' <<EOF
+benchmark/Benchmark.scala
@@ -15,7 +15,7 @@ object Benchmark {
   val benchmarks = js.Array[Benchmark](
+)
   val benchmarkApps = js.Array[Benchmar
+kApp]()
 
-  val global = js.Dynamic.global.asInst
+anceOf[js.Dictionary]
+  val global = js.Dynamic.global.asInst
+anceOf[js.Dictionary[js.Any]]
   global("runScalaJSBenchmarks") = runB
+enchmarks _
   global("initScalaJSBenchmarkApps") =
+initBenchmarkApps _
 
 
 
 
 
 
 
 
 
 
 
 
 
[diff] Changes to 'common/src/main/ 100%
EOF

